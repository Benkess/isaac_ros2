Bootstrap: docker
From: nvcr.io/nvidia/isaac-sim:{{ISAAC_VERSION}}

%arguments
    ISAAC_VERSION=4.5.0

%environment
    # (Optional) Accept NVIDIA Omniverse EULA & privacy terms
    export ACCEPT_EULA=Y
    export PRIVACY_CONSENT=Y

    # (Optional) Where the Isaac Sim package lives inside the container
    export ISAAC_SIM_PACKAGE_PATH=/isaac-sim

    # (Optional) ROS-2 bridge libs (will be available if you bind-mount a ROS workspace)
    # export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
    # export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$ISAAC_SIM_PACKAGE_PATH/exts/isaacsim.ros2.bridge/humble/lib"

    # (Optional) custom Fast-DDS profile
    # export FASTRTPS_DEFAULT_PROFILES_FILE=/root/.ros/fastdds.xml

    # (Optional) Persistent Nucleus root (bind-mount /persistent/isaac/asset_root at runtime)
    # export ISAAC_NUCLEUS_ROOT=/persistent/isaac/asset_root

%post
    set -eux

    # Configure timezone non-interactively
    export DEBIAN_FRONTEND=noninteractive
    export TZ=America/New_York
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime
    echo $TZ > /etc/timezone

    # Update and install
    apt-get update && apt-get install -y \
      curl gnupg2 lsb-release \
      software-properties-common \
      python3-pip python3-venv \
      locales build-essential \
      tzdata \
      nano \
    && locale-gen en_US.UTF-8 || true \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8

    # (Optional) pip packages for your custom simulation scripts
    # pip3 install --no-cache-dir <your-package-list>

    # Clean up
    rm -rf /var/lib/apt/lists/*

%labels
    Maintainer mxk3rz
    Version v1.0.0

%help
    This container bundles:
      • Isaac Sim & Omniverse Runtime
      • Python & NVIDIA SDKs

    Use `--overlay` to inject project‐specific packages.

    Build:
      apptainer build isaac-sim.sif isaac-sim.def
